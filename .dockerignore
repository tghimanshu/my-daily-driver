# Keep secrets out of the build context. .env is passed at run time by
# docker-compose, so it must never be baked into a layer.
.env
.env.*
*.pem

.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
*.egg-info/

# Not needed at run time.
test_dashboard.py
Dockerfile
docker-compose.yml
README.md
.DS_Store
