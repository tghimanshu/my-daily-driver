# Copy to .env and fill in. The app reads this file on startup; real
# environment variables always win over anything set here.
#
# Set DAILY_DRIVER_SKIP_DOTENV=1 to ignore this file completely, for when the
# environment is already authoritative and a stray .env should not be read. The
# test suite sets it, so a test run never picks up your real accounts.
# DAILY_DRIVER_SKIP_DOTENV=0

# Signs the session cookie. The cookie only holds an id for the server-side
# credential store, so this guards those tokens. Anything under 32 characters is
# refused and replaced with a random key for the run, which logs you out.
SECRET_KEY=change_me
PORT=5000
# Leave HOST alone to serve on 127.0.0.1 only. Setting it to 0.0.0.0 exposes the
# dashboard to your network, and only makes sense behind a TLS terminator.
# Both compose files override this to 0.0.0.0, which the container needs to be
# reachable at all; neither publishes it on a routable host address.
HOST=127.0.0.1
# The Werkzeug debugger that debug mode enables is a remote shell. Keep it off
# unless you are actively debugging on loopback.
FLASK_DEBUG=0

# GitHub: register an OAuth app at https://github.com/settings/developers with
# the callback URL below, then use "Connect GitHub" in the dashboard. Whichever
# compose file you run decides the real URL: docker-compose.yml serves
# http://localhost:5000, and docker-compose.home-server.yml serves
# https://dashboard.home through Caddy and overrides this with its own value, so
# you only have to edit this line if you are running neither.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/oauth/github/callback
# Optional: a personal access token (read:user) used instead of the browser
# login. Grants the 5000 requests/hour rate limit.
GITHUB_TOKEN=
# Optional: public data only, no token required.
GITHUB_USERNAME=

# LeetCode: there is no third-party OAuth app to register, so the dashboard
# authenticates with the cookies from your signed-in leetcode.com browser
# session. Copy LEETCODE_SESSION from DevTools -> Application -> Cookies, and
# paste it into "Connect LeetCode" in the dashboard.
LEETCODE_SESSION=
# Optional, only needed for write requests.
LEETCODE_CSRF_TOKEN=
# Optional: lets the dashboard fall back to this account for public data.
LEETCODE_USERNAME=

# Focus timer defaults. The widget lets you change all of these per browser, and
# what is set here is what a browser starts from. A blank or non-numeric value
# falls back to the built-in default, and anything out of range is clamped.
#   POMODORO_WORK_MINUTES=25
#   POMODORO_SHORT_BREAK_MINUTES=5
#   POMODORO_LONG_BREAK_MINUTES=15
# Focus rounds before a long break, and the number a day is aiming for. Set the
# goal to 0 to switch the day's target off.
#   POMODORO_ROUNDS=4
#   POMODORO_GOAL=8

# Self-hosted sites to watch, comma separated as name=url. The name is what the
# widget shows, and a bare url works too if you would rather use the host.
#   SELF_HOSTED_SITES=blog=https://blog.example.com,immich=http://10.0.0.4:2283
# Append |keyword to also require that string in the response body, which
# catches a service that answers 200 with an error page:
#   SELF_HOSTED_SITES=immich=http://10.0.0.4:2283|Immich
# Any 2xx or 3xx counts as up. Checks run concurrently, in parallel with the
# rest of the dashboard, and results are cached for a minute.
#
# Under docker compose the dashboard shares a network with the other stack, so
# its containers can be addressed by name, which is faster and does not depend
# on a published port:
#   SELF_HOSTED_SITES=it-tools=http://it-tools,hoarder=http://hoarder:3000
# Use host.docker.internal:<port> for anything not on that network.
SELF_HOSTED_SITES=
